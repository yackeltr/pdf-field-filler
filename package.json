{
  "name": "pdf-field-filler",
  "version": "0.3.1",
  "description": "Local MCP server for safely inspecting and filling AcroForm PDFs.",
  "license": "MIT",
  "author": "Tom Yackel",
  "keywords": [
    "mcp",
    "pdf",
    "acroform",
    "claude-desktop",
    "model-context-protocol"
  ],
  "type": "module",
  "bin": {
    "pdf-field-filler": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "node dist/cli.js inspect",
    "dry-run": "node dist/cli.js dry-run",
    "validate": "node dist/cli.js validate",
    "export-map": "node dist/cli.js export-map",
    "build:mcpb": "mkdir -p dist-mcpb/server && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist-mcpb/server/index.mjs && cp manifest.json dist-mcpb/ && mcpb pack dist-mcpb/ pdf-field-filler.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "pdf-lib": "1.17.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "22.19.19",
    "esbuild": "^0.27.7",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
